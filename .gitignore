# Build output
/site/
/dist/
/bin/
*.test
*.out

# Go
vendor/

# Node
node_modules/

# Generated acceptance evidence — the pipeline regenerates it on every run
bundles/

# Helm
deployment/helm/**/charts/
deployment/helm/**/*.tgz

# Secrets and local config — never commit these
.env
.env.*
*.pem
*.p12
*.key
kubeconfig*

# Editors and OS
.idea/
.vscode/
.DS_Store

# Local developer cluster state (identity kubeconfigs) - never commit
/.dev/

# Pinned tools installed by scripts/tools/install.sh
.tools/
/scripts/verify-tspa-api/bodies/
