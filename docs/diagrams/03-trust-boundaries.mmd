%% Render: npx -y -p @mermaid-js/mermaid-cli mmdc --no-font-embed -i docs/diagrams/03-trust-boundaries.mmd -o docs/diagrams/03-trust-boundaries.svg
%% Diagram 03, trust boundaries. Illustrates ARCHITECTURE section 6; the allow matrix there is the place of record.
%% Edges are drawn at zone level so that each zone keeps its own top-to-bottom layout (Mermaid ignores a subgraph direction once a node inside it links outside).
%% --no-font-embed: the embedded webfont is measured before it loads, which clips the widest line of every label in browsers.
%%{init: {"flowchart": {"nodeSpacing": 30, "rankSpacing": 70, "wrappingWidth": 360}}}%%
flowchart LR
  accTitle: Diagram 03, trust boundaries between the zones and the planes
  accDescr {
    Two SPIFFE trust domains, zone-a and zone-b, each one cluster. Inside each zone the data-plane workloads, which hold SVIDs, sit next to the management-plane components placed in that zone: the SPIRE server, the OpenTelemetry Collector and cmcd. Calls from the data plane into that management plane are denied by default at both the NetworkPolicy and the mesh layer and are allowed only along the ZT-55 allow-matrix paths: named mTLS pairs and the ZT-26 observability export.
    Zone-a reaches zone-b only through the attested channel plus a TRAIN verdict.
    The management-plane components whose placement is not yet recorded, TRAIN (TCR and TSPA), the TSA policy engine and OCM, are drawn outside both zones; both zones reach them under the same rule, the ZT-55 allow matrix at both layers.
    Anything without an SVID or with an unsigned image is denied: it cannot join or cannot start.
    The allow matrix in architecture section 6 is the place of record for every permitted path.
  }
  classDef data fill:#e8f1fb,stroke:#2b5d8c,color:#10243a
  classDef mgmt fill:#fff3d6,stroke:#a86b00,color:#3a2600
  classDef prov fill:#fff3d6,stroke:#a86b00,stroke-dasharray:6 4,color:#3a2600
  classDef ext fill:#f4f4f4,stroke:#666,color:#222
  classDef deny fill:#fbe3e3,stroke:#b3261e,color:#5c0f0b

  subgraph TD_A["SPIFFE trust domain zone-a (one cluster)"]
    direction TB
    A1["data plane<br/>workloads with SVIDs"]:::data
    A2["management plane, placed here:<br/>SPIRE server · OTel collector · cmcd"]:::mgmt
    A1 -. "default DENY at both layers (NetworkPolicy · mesh)<br/>crossed only by the ZT-55 allow-matrix paths:<br/>named mTLS pairs · ZT-26 observability export" .-> A2
  end
  subgraph TD_B["SPIFFE trust domain zone-b (one cluster)"]
    direction TB
    B1["data plane<br/>workloads with SVIDs"]:::data
    B2["management plane, placed here:<br/>SPIRE server · OTel collector · cmcd"]:::mgmt
    B1 -. "default DENY at both layers (NetworkPolicy · mesh)<br/>crossed only by the ZT-55 allow-matrix paths:<br/>named mTLS pairs · ZT-26 observability export" .-> B2
  end
  TD_A == "ONLY via attested channel<br/>+ TRAIN verdict" ==> TD_B
  TD_A ~~~ MGMT_P

  MGMT_P["management plane, placement not yet recorded:<br/>TRAIN (TCR, TSPA) · TSA policy engine · OCM"]:::prov
  TD_A -. "same rule: ZT-55 allow matrix, both layers" .-> MGMT_P
  TD_B -. "same rule: ZT-55 allow matrix, both layers" .-> MGMT_P

  EXT["anything without SVID<br/>or with an unsigned image"]:::ext
  X(["denied"]):::deny
  EXT -- "cannot join / cannot start" --> X

  style TD_A fill:#f7f9fc,stroke:#7a8aa0
  style TD_B fill:#f7f9fc,stroke:#7a8aa0
