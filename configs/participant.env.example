# Local two-process sample. Contains no credentials or production endpoints.
# Local two-process sample; set these in the process environment.
# In containers use :8085 and a reachable Resource Service address instead.
PARTICIPANT_ADDRESS=127.0.0.1:8085
# Outbound request deadline. Server read/write deadlines are this value + 5s.
PARTICIPANT_REQUEST_TIMEOUT=5s
# sample (default) or http-sample. The HTTP adapter is local sample-to-sample only.
PARTICIPANT_ADAPTER_MODE=http-sample
# Required only when PARTICIPANT_ADAPTER_MODE=http-sample.
PARTICIPANT_RESOURCE_URL=http://127.0.0.1:8086
PARTICIPANT_LOG_LEVEL=info
