# Deployment shape on the shared OSC namespace; the application-service chart sets these.
# Set these on the Participant process. The service does not load this file.
PARTICIPANT_ADDRESS=:8085
PARTICIPANT_REQUEST_TIMEOUT=5s
PARTICIPANT_ADAPTER_MODE=http-sample
# Example assumes a Service named protected-resource exposing port 8086.
# Base URL only: the adapter appends /demo.
PARTICIPANT_RESOURCE_URL=http://protected-resource.zero-trust.svc.cluster.local:8086
PARTICIPANT_LOG_LEVEL=info
