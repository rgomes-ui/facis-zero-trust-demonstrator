# Local sample-only Protected Resource service. Contains no credentials.
PROTECTED_RESOURCE_ADDRESS=:8086
PROTECTED_RESOURCE_REQUEST_TIMEOUT=5s
PROTECTED_RESOURCE_SLOW_DELAY=2s
PROTECTED_RESOURCE_MODE=sample
# sample (default) or sample-alternative. Both remain deterministic sample adapters.
PROTECTED_RESOURCE_ADAPTER_MODE=sample
PROTECTED_RESOURCE_LOG_LEVEL=info
