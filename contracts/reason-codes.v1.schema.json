{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eclipse-xfsc/facis-zero-trust-demonstrator/docs/contracts/reason-codes.v1.schema.json",
  "title": "Reason-code registry (contracts v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "families"],
  "properties": {
    "$comment": { "type": "string" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "families": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z]{2,5}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "http", "ui", "codes"],
        "properties": {
          "layer": { "type": "string", "minLength": 1 },
          "http": { "$ref": "#/$defs/status" },
          "ui": { "type": "string", "pattern": "^[A-Z]+(-[A-Z]+)*$" },
          "codes": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[A-Z]{2,5}(-[A-Z0-9]+)+$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["meaning"],
              "properties": {
                "meaning": { "type": "string", "minLength": 1 },
                "http": { "$ref": "#/$defs/status" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "description": "HTTP status of the refusal; null when the layer refuses without an HTTP response of its own.",
      "oneOf": [{ "type": "integer", "minimum": 400, "maximum": 599 }, { "type": "null" }]
    }
  }
}
